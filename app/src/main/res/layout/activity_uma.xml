<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_header" />

        <!-- Las tarjetas se montan un poco sobre la cabecera. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-40dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/Sanji.Card">

                <TextView
                    style="@style/Sanji.Hint"
                    android:text="@string/uma_section_hint"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Sanji.Label"
                    android:text="@string/target_label" />

                <Spinner
                    android:id="@+id/targetSpinner"
                    style="@style/Sanji.Spinner" />

                <TextView
                    android:id="@+id/umaOpacityLabel"
                    style="@style/Sanji.Label" />

                <SeekBar
                    android:id="@+id/umaOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:max="100"
                    android:progressTint="#A4574A"
                    android:thumbTint="@color/brass" />
            </LinearLayout>

            <LinearLayout style="@style/Sanji.Card">

                <Button
                    android:id="@+id/startButton"
                    style="@style/Sanji.Button.Primary"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/btn_uma"
                    android:text="@string/uma_start" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/Sanji.Button.Outline"
                    android:text="@string/stop" />

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/sanji_primary" />
            </LinearLayout>

            <LinearLayout style="@style/Sanji.Card">

                <TextView
                    style="@style/Sanji.CardTitle"
                    android:text="@string/howto_title" />

                <TextView
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="8dp"
                    android:text="@string/uma_howto"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
