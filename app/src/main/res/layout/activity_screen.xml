<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_header" />

        <!-- Las tarjetas se montan un poco sobre la cabecera. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-40dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/Sanji.Card">

                <TextView
                    style="@style/Sanji.CardTitle"
                    android:text="@string/languages_title" />

                <TextView
                    style="@style/Sanji.Label"
                    android:text="@string/source_label" />

                <Spinner
                    android:id="@+id/sourceSpinner"
                    style="@style/Sanji.Spinner" />

                <TextView
                    style="@style/Sanji.Label"
                    android:text="@string/target_label" />

                <Spinner
                    android:id="@+id/targetSpinner"
                    style="@style/Sanji.Spinner" />
            </LinearLayout>

            <LinearLayout style="@style/Sanji.Card">

                <Button
                    android:id="@+id/startButton"
                    style="@style/Sanji.Button.Primary"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/btn_screen"
                    android:text="@string/start" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/Sanji.Button.Outline"
                    android:text="@string/stop" />

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/sanji_primary" />
            </LinearLayout>

            <LinearLayout style="@style/Sanji.Card">

                <TextView
                    style="@style/Sanji.CardTitle"
                    android:text="@string/howto_title" />

                <TextView
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="8dp"
                    android:text="@string/howto"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
