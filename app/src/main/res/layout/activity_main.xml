<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera: el nombre de la app sobre el degradado violeta y rosa. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_main"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="64dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#F0D79A"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.92"
                android:text="@string/home_subtitle"
                android:textColor="#EBDDBF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Los cuadros se montan un poco sobre la cabecera. -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="-44dp"
            android:layout_marginEnd="10dp"
            android:columnCount="2">

            <LinearLayout
                android:id="@+id/tileUma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/tile_uma"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/umaIcon"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/icon_frame"
                    android:contentDescription="@string/tile_uma_title"
                    android:scaleType="centerCrop"
                    android:src="@drawable/uma_musume" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_uma_title"
                        android:textSize="20sp"
                        android:fontFamily="@font/cinzel_decorative"
                        android:textColor="#F0D79A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.92"
                        android:text="@string/tile_uma_hint"
                        android:textColor="#EBDDBF"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="›"
                    android:textColor="#EBDDBF"
                    android:textSize="30sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileScreen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/tile_screen"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:minHeight="160dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/icon_frame"
                    android:gravity="center"
                    android:text="文A"
                    android:textColor="#EBDDBF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/tile_screen_title"
                    android:textSize="17sp"
                    android:fontFamily="@font/cinzel_decorative"
                    android:textColor="#F0D79A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.92"
                    android:text="@string/tile_screen_hint"
                    android:textColor="#EBDDBF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileWeb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/tile_web"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:minHeight="160dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/icon_frame"
                    android:gravity="center"
                    android:text="🔗"
                    android:textColor="#EBDDBF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/tile_web_title"
                    android:textSize="17sp"
                    android:fontFamily="@font/cinzel_decorative"
                    android:textColor="#F0D79A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.92"
                    android:text="@string/tile_web_hint"
                    android:textColor="#EBDDBF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileLive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/tile_live"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/icon_frame"
                    android:gravity="center"
                    android:text="🎙"
                    android:textSize="26sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_live_title"
                        android:textSize="20sp"
                        android:fontFamily="@font/cinzel_decorative"
                        android:textColor="#F0D79A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:alpha="0.92"
                        android:text="@string/tile_live_hint"
                        android:textColor="#EBDDBF"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="›"
                    android:textColor="#EBDDBF"
                    android:textSize="30sp" />
            </LinearLayout>
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/Sanji.Card">

                <TextView
                    style="@style/Sanji.CardTitle"
                    android:text="@string/settings_title" />

                <Switch
                    android:id="@+id/onlineSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/live_online"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="4dp"
                    android:text="@string/online_hint" />
            </LinearLayout>

            <LinearLayout style="@style/Sanji.Card">

                <TextView
                    style="@style/Sanji.CardTitle"
                    android:text="@string/update_section" />

                <TextView
                    android:id="@+id/versionText"
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/updateButton"
                    style="@style/Sanji.Button.Outline"
                    android:text="@string/update_check" />

                <TextView
                    android:id="@+id/statusText"
                    style="@style/Sanji.Hint"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sanji_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
