<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <RadioGroup
        android:id="@+id/formatGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/formatZip">

        <RadioButton
            android:id="@+id/formatZip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_zip" />

        <RadioButton
            android:id="@+id/formatPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_pdf" />

        <RadioButton
            android:id="@+id/formatEpub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_epub" />

        <RadioButton
            android:id="@+id/formatTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download_txt" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/translateImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="true"
        android:text="@string/download_translate_images" />
</LinearLayout>
