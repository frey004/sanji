<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de metal pulido con borde oscuro. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FFF3D6">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:centerColor="#A67C3D"
                android:endColor="#6E4F22"
                android:startColor="#E2C27A" />
            <stroke
                android:width="1.5dp"
                android:color="#4A3315" />
        </shape>
    </item>
</ripple>
