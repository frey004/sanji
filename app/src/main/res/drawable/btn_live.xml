<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de metal pulido con borde oscuro. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FFF3D6">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:centerColor="#4A4038"
                android:endColor="#1E1A17"
                android:startColor="#8A7D72" />
            <stroke
                android:width="1.5dp"
                android:color="#15120F" />
        </shape>
    </item>
</ripple>
