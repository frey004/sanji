<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de metal pulido con borde oscuro. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FFF3D6">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:centerColor="#3F7A66"
                android:endColor="#1F3D35"
                android:startColor="#7FB8A0" />
            <stroke
                android:width="1.5dp"
                android:color="#16302A" />
        </shape>
    </item>
</ripple>
