<?xml version="1.0" encoding="utf-8"?>
<!-- Placa metálica con marco de latón, remaches y un engranaje grabado. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40F0D79A">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="135"
                android:endColor="#A4574A"
                android:startColor="#5A2430" />
            <stroke
                android:width="2.5dp"
                android:color="#C9A45C" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:end="5dp"
        android:start="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#80E2C27A" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:bottom="-28dp"
        android:end="-28dp"
        android:gravity="bottom|end"
        android:drawable="@drawable/ic_gear" />
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="top|start"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="top|end"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="bottom|start"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="bottom|end"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
</ripple>
