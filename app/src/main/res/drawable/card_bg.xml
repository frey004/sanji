<?xml version="1.0" encoding="utf-8"?>
<!-- Pergamino con doble filete de latón y remaches en las esquinas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="2dp"
                android:color="@color/outline" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:end="5dp"
        android:start="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <stroke
                android:width="0.8dp"
                android:color="@color/outline" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="top|start"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="top|end"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="bottom|start"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="7dp"
        android:height="7dp"
        android:gravity="bottom|end"
        android:top="9dp"
        android:bottom="9dp"
        android:start="9dp"
        android:end="9dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#7A5A2B"
                android:gradientRadius="5dp"
                android:startColor="#F0D79A"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
